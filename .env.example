# ─────────────────────────────────────────────────────────────────────────────
# AI GitHub Repository Health Monitor — Environment Template
# Copy this file to .env (never commit .env) and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-secret

# ── Backend API ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=healthmonitor
POSTGRES_PASSWORD=changeme
POSTGRES_DB=healthmonitor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://healthmonitor:changeme@localhost:5432/healthmonitor

# Test database (isolated — never use production credentials here)
TEST_DATABASE_URL=postgresql+asyncpg://healthmonitor:changeme@localhost:5432/healthmonitor_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── GitHub App ───────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=             # base64-encoded PEM
GITHUB_APP_WEBHOOK_SECRET=          # secret used to sign webhook deliveries
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ── NextAuth.js (frontend) ───────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI Provider ──────────────────────────────────────────────────────────────
# Set AI_PROVIDER to one of the values below, then fill in the matching key.
# Supported: openai | anthropic | google | groq | mistral | cohere
#            together | perplexity | xai | deepseek | ollama
AI_PROVIDER=openai

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o                  # gpt-4o | gpt-4o-mini | gpt-4-turbo

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5    # claude-opus-4 | claude-sonnet-4-5 | claude-haiku-3-5

# ── Google AI (Gemini) ───────────────────────────────────────────────────────
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash     # gemini-2.5-pro | gemini-2.0-flash | gemini-1.5-pro

# ── Groq (fast open-source models) ──────────────────────────────────────────
# Get key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # llama-3.3-70b-versatile | mixtral-8x7b-32768 | gemma2-9b-it

# ── Mistral AI ───────────────────────────────────────────────────────────────
# Get key at: https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest   # mistral-large-latest | mistral-small-latest | open-mixtral-8x22b

# ── Cohere ───────────────────────────────────────────────────────────────────
# Get key at: https://dashboard.cohere.com
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024  # command-r-plus-08-2024 | command-r-08-2024

# ── Together AI (open-source model hosting) ──────────────────────────────────
# Get key at: https://api.together.xyz
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# ── Perplexity AI ────────────────────────────────────────────────────────────
# Get key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=llama-3.1-sonar-large-128k-online

# ── xAI (Grok) ───────────────────────────────────────────────────────────────
# Get key at: https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-beta

# ── DeepSeek ─────────────────────────────────────────────────────────────────
# Get key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat         # deepseek-chat | deepseek-reasoner

# ── Ollama (local / self-hosted) ─────────────────────────────────────────────
# No API key needed — just run Ollama locally: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Email / Notifications ────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp                  # smtp | sendgrid | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
